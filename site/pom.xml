<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.sauloaraujo</groupId>
		<artifactId>d5-pai</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>d5-site</artifactId>

	<name>D5 Site</name>
	<description>Aplicação web com a documentação de D5, gerada com MkDocs e servida na raiz, e o gerador de projetos.</description>

	<properties>
		<mkdocs.imagem>squidfunk/mkdocs-material:9.7</mkdocs.imagem>
	</properties>

	<dependencies>
		<dependency>
			<groupId>dev.sauloaraujo</groupId>
			<artifactId>d5-gerador-nucleo</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Os snippets do site incluem arquivos de framework e dos exemplos, então o MkDocs
			roda com a raiz do repositório montada em /docs. Requer Docker. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>mkdocs-build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>docker</executable>
							<arguments>
								<argument>run</argument>
								<argument>--rm</argument>
								<argument>-v</argument>
								<argument>${project.basedir}/..:/docs</argument>
								<argument>${mkdocs.imagem}</argument>
								<argument>build</argument>
								<argument>--strict</argument>
								<argument>-f</argument>
								<argument>site/src/main/mkdocs/mkdocs.yml</argument>
								<argument>-d</argument>
								<argument>/docs/site/target/classes/META-INF/resources</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Constrói a imagem de contêiner, sem Dockerfile, no daemon Docker local:
		mvn -pl site -am package -Pimagem
		A imagem fica no Docker local com o nome d5-site:<versão>. -->
		<profile>
			<id>imagem</id>

			<build>
				<plugins>
					<plugin>
						<groupId>com.google.cloud.tools</groupId>
						<artifactId>jib-maven-plugin</artifactId>
						<version>3.4.5</version>
						<configuration>
							<from>
								<image>eclipse-temurin:25-jre</image>
							</from>
							<to>
								<image>d5-site:${project.version}</image>
							</to>
							<container>
								<mainClass>dev.sauloaraujo.d5.site.SiteAplicacao</mainClass>
								<ports>
									<port>8080</port>
								</ports>
							</container>
						</configuration>
						<executions>
							<execution>
								<phase>package</phase>
								<goals>
									<goal>dockerBuild</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
