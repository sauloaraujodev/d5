<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>dev.sauloaraujo</groupId>
		<artifactId>d5-pai</artifactId>
		<version>1.0.0-SNAPSHOT</version>
	</parent>

	<artifactId>d5-site</artifactId>

	<name>D5 Site</name>
	<description>Site da documentação de D5, gerado com MkDocs e empacotado em META-INF/resources.</description>

	<properties>
		<mkdocs.imagem>squidfunk/mkdocs-material:9.7</mkdocs.imagem>
	</properties>

	<build>
		<plugins>
			<!-- Os snippets do site incluem arquivos de framework e dos exemplos, então o MkDocs
			roda com a raiz do repositório montada em /docs. Requer Docker. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>mkdocs-build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>docker</executable>
							<arguments>
								<argument>run</argument>
								<argument>--rm</argument>
								<argument>-v</argument>
								<argument>${project.basedir}/..:/docs</argument>
								<argument>${mkdocs.imagem}</argument>
								<argument>build</argument>
								<argument>--strict</argument>
								<argument>-f</argument>
								<argument>site/src/main/mkdocs/mkdocs.yml</argument>
								<argument>-d</argument>
								<argument>/docs/site/target/classes/META-INF/resources</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
